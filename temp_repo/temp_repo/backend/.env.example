SNS_TOPIC_ARN=arn:aws:sns:us-east-1:YOUR_ACCOUNT_ID:nexus-notifications
STEP_FUNCTION_ARN=arn:aws:states:us-east-1:YOUR_ACCOUNT_ID:stateMachine:nexus-simulation
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
LOG_LEVEL=INFO
